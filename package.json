{
  "name": "nwgrabio-electron",
  "version": "1.4.2",
  "description": "Grab Anything, From Anywhere. A free, open source Windows app for downloading video and audio from YouTube, TikTok, Instagram, Facebook, and 1000+ other sites.",
  "main": "src/main.js",
  "author": "Nethum Welikada",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "io.github.nethumwelikada.nwgrabio",
    "productName": "NWGrabio",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
